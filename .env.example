# =============================================================================
# Real-Time Fraud Detection Pipeline - configuration template
# =============================================================================
# Copy to `.env` and adjust. Every component reads its settings from these
# variables (see common/config.py); nothing is hardcoded in application code.
#
#   cp .env.example .env
#
# Host-vs-container note: values below are the defaults used when running a
# component ON THE HOST against the Docker stack. Services running INSIDE the
# compose network receive container-internal overrides from docker-compose.yml
# (e.g. KAFKA_BOOTSTRAP_SERVERS=kafka:29092, CASSANDRA_CONTACT_POINTS=cassandra).
# =============================================================================

# -----------------------------------------------------------------------------
# Kafka
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRANSACTIONS_TOPIC=transactions
KAFKA_ALERTS_TOPIC=fraud-alerts
KAFKA_DLQ_TOPIC=transactions-dlq

# Partition count drives maximum consumer parallelism. Keep >= the number of
# Spark cores assigned to the streaming job (see docs/architecture.md).
KAFKA_TRANSACTIONS_PARTITIONS=6
KAFKA_ALERTS_PARTITIONS=3
KAFKA_DLQ_PARTITIONS=1
KAFKA_REPLICATION_FACTOR=1

KAFKA_CONSUMER_GROUP=fraud-stream-job

# Producer throughput tuning. linger_ms > 0 lets the client build larger
# batches, trading a few ms of latency for significantly higher throughput.
KAFKA_PRODUCER_LINGER_MS=10
KAFKA_PRODUCER_BATCH_SIZE=65536
KAFKA_PRODUCER_COMPRESSION=lz4
KAFKA_PRODUCER_ACKS=1

# Connection resilience: exponential backoff with jitter, capped.
KAFKA_MAX_CONNECT_RETRIES=8
KAFKA_RETRY_BACKOFF_SECONDS=1.0
KAFKA_RETRY_BACKOFF_MAX_SECONDS=30.0

# -----------------------------------------------------------------------------
# Cassandra
# -----------------------------------------------------------------------------
CASSANDRA_CONTACT_POINTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=fraud_detection
CASSANDRA_DATACENTER=datacenter1
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=

# Unlogged batches grouped by partition key; keep modest to avoid coordinator
# pressure (Cassandra warns above ~5 KiB / 100 statements per batch).
CASSANDRA_WRITE_BATCH_SIZE=100
CASSANDRA_MAX_WRITE_RETRIES=5
CASSANDRA_REQUEST_TIMEOUT_SECONDS=15.0

# TTL in seconds for raw transaction rows (90 days). 0 disables expiry.
CASSANDRA_RAW_TTL_SECONDS=7776000

# -----------------------------------------------------------------------------
# Dataset and producer
# -----------------------------------------------------------------------------
# Path to the PaySim CSV. The Kaggle file is named
# PS_20174392719_1491204439457_log.csv; `make dataset` generates a
# schema-identical synthetic file at data/paysim.csv if you do not have it.
PAYSIM_CSV_PATH=data/paysim.csv

# Rows per pandas chunk. Bounds producer memory regardless of file size.
PRODUCER_CHUNK_SIZE=50000

# Target transactions per second. 0 publishes as fast as the broker accepts,
# which is what the load test uses.
PRODUCER_TPS=50

# Flush cadence: the producer blocks for broker acknowledgement after this many
# records, or after this many seconds, whichever comes first. Both bounds
# matter. The record bound caps how much unacknowledged data a crash can lose;
# the time bound keeps the Prometheus counters advancing smoothly at low rates,
# where waiting for 500 records would mean one counter step every 10 seconds and
# a visibly blocky rate() graph.
PRODUCER_FLUSH_EVERY_RECORDS=500
PRODUCER_FLUSH_INTERVAL_SECONDS=1.0

PRODUCER_STATS_INTERVAL_SECONDS=10
PRODUCER_METRICS_PORT=8001

# -----------------------------------------------------------------------------
# Feature engineering (shared by training and streaming - must match)
# -----------------------------------------------------------------------------
# Rolling window, in PaySim `step` units (1 step == 1 simulated hour), used for
# per-account transaction velocity features.
VELOCITY_WINDOW_STEPS=24
# Upper bound on accounts tracked in the streaming velocity cache (LRU evicted).
VELOCITY_CACHE_MAX_ACCOUNTS=500000

# -----------------------------------------------------------------------------
# Model training
# -----------------------------------------------------------------------------
MODEL_ARTIFACT_DIR=training/artifacts
TRAINING_SAMPLE_ROWS=1000000
TRAINING_RANDOM_SEED=42

ISOLATION_FOREST_N_ESTIMATORS=200
ISOLATION_FOREST_MAX_SAMPLES=65536
ISOLATION_FOREST_CONTAMINATION=0.0015

AUTOENCODER_EPOCHS=12
AUTOENCODER_BATCH_SIZE=1024
AUTOENCODER_LATENT_DIM=6
AUTOENCODER_LEARNING_RATE=0.001

# Threshold tuning target. The decision threshold is chosen as the most precise
# operating point that still reaches this recall, because a missed fraud (false
# negative) costs far more than a reviewed false positive.
TARGET_MIN_RECALL=0.95

# -----------------------------------------------------------------------------
# Spark Structured Streaming
# -----------------------------------------------------------------------------
SPARK_MASTER=local[4]
SPARK_APP_NAME=fraud-stream-job
SPARK_CHECKPOINT_DIR=checkpoints/fraud-stream
SPARK_TRIGGER_INTERVAL=2 seconds
SPARK_MAX_OFFSETS_PER_TRIGGER=20000
SPARK_SHUFFLE_PARTITIONS=8
SPARK_EXECUTOR_MEMORY=2g
SPARK_DRIVER_MEMORY=2g
SPARK_ARROW_BATCH_SIZE=10000
SPARK_STARTING_OFFSETS=latest

# Watermark for dropping late-arriving records.
STREAMING_WATERMARK=5 minutes
STREAMING_METRICS_PORT=8002

# Persist every scored transaction to transactions_raw (set false to store
# alerts only, which materially reduces write amplification).
STREAMING_PERSIST_RAW=true

# -----------------------------------------------------------------------------
# Dashboard
# -----------------------------------------------------------------------------
STREAMLIT_REFRESH_SECONDS=5
STREAMLIT_ALERT_LIMIT=100

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
# text for human-readable console output, json for structured log shipping.
LOG_FORMAT=text
