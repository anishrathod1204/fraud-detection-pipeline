# ---- Kafka ----
KAFKA_BOOTSTRAP=kafka:29092
KAFKA_TOPIC=transactions
KAFKA_GROUP=fraud-scorer

# ---- Cassandra ----
CASSANDRA_HOSTS=cassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=fraud

# ---- Producer ----
# Transactions per second sent to Kafka
PRODUCER_RATE=40
# Data file: real PaySim CSV if you place it at data/paysim.csv, else generated data
DATA_FILE=/app/data/paysim.csv

# ---- Model ----
MODEL_PATH=/app/models/isolation_forest.joblib

# ---- Metrics ----
METRICS_PORT=8000
