# ---------------------------------------------------------------------------
# Datasets - PaySim is ~470 MB, never commit it
# ---------------------------------------------------------------------------
data/
*.csv
*.csv.gz
*.parquet

# ---------------------------------------------------------------------------
# Model artifacts - regenerate with `make train`, do not version binaries
# ---------------------------------------------------------------------------
training/artifacts/*
!training/artifacts/.gitkeep

# Generated evaluation report (written by training/train_model.py)
docs/model_evaluation.md

